Subject: [PATCH] ART: use ashmem for private JIT cache on legacy kernels

When memfd_create is absent, use the existing ashmem allocator to create
a shared backing object for separate writable and executable mappings.
Retain normal memfd and existing error paths on other kernels.

diff --git a/runtime/jit/jit_memory_region.cc b/runtime/jit/jit_memory_region.cc
index e3a97ef..9311774 100644
--- a/runtime/jit/jit_memory_region.cc
+++ b/runtime/jit/jit_memory_region.cc
@@ -83,6 +83,17 @@ bool JitMemoryRegion::Initialize(size_t initial_capacity,
   } else {
     // Bionic supports memfd_create, but the call may fail on older kernels.
     mem_fd = unique_fd(art::memfd_create("jit-cache", /* flags= */ 0));
+    bool ashmem_created = false;
+#if defined(__BIONIC__) && defined(ART_TARGET)
+    if (mem_fd.get() < 0 && errno == ENOSYS) {
+      // Legacy kernels can still provide separate writable and executable views with ashmem.
+      int ashmem_fd = -1;
+      if (PaletteAshmemCreateRegion("jit-cache", capacity, &ashmem_fd) == PALETTE_STATUS_OK) {
+        mem_fd.reset(ashmem_fd);
+        ashmem_created = true;
+      }
+    }
+#endif
     if (mem_fd.get() < 0) {
       std::ostringstream oss;
       oss << "Failed to initialize dual view JIT. memfd_create() error: " << strerror(errno);
@@ -93,7 +104,7 @@ bool JitMemoryRegion::Initialize(size_t initial_capacity,
         return false;
       }
       VLOG(jit) << oss.str();
-    } else if (ftruncate(mem_fd, capacity) != 0) {
+    } else if (!ashmem_created && ftruncate(mem_fd, capacity) != 0) {
       std::ostringstream oss;
       oss << "Failed to initialize memory file: " << strerror(errno);
       *error_msg = oss.str();
